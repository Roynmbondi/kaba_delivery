# Configuration de l'application KABA-DELIVERY
NODE_ENV=production
PORT=3000

# API Configuration
API_BASE_URL=http://localhost:3001
API_TIMEOUT=5000

# Database (pour future implémentation)
DATABASE_URL=your_database_url_here

# Authentification (pour future implémentation)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Services externes
DELIVERY_API_KEY=your_delivery_api_key_here
MAPS_API_KEY=your_maps_api_key_here

# Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true

# Sécurité
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100